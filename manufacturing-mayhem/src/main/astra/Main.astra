// 入口 agent：按场景信念搭建工厂，并逐张处理订单
agent Main extends Base {
    // 场景数据：换场景只改下面的 initial
    types scenario {
        formula zone(string, string);
        formula robotSpec(string);
        formula orderSpec(string, list, int);
        formula idle(string);                          // 空闲、可派任务的机器人
    }

    // 订单队列：orderSpec(编号, 零件, 价值)
    initial orderSpec("o1", ["apple-pie"], 10);
    initial orderSpec("o2", ["apple-pie"], 10);
    initial orderSpec("o3", ["boxed-pie"], 30);

    // 仓库库存
    initial stock("apples", 4);
    initial stock("pastry", 10);
    initial stock("box", 5);

    // zone(类型, 名字)，类型为 ap / sp / pp / ws
    initial zone("ap", "ap1");
    initial zone("ap", "ap2");
    initial zone("sp", "sp1");
    initial zone("pp", "pp1");
    initial zone("ws", "ws1");
    initial zone("ws", "ws2");

    // 机器人，每个自动配 <名字>-charger
    initial robotSpec("r1");
    initial robotSpec("r2");

    // 工作站配方：输入、产出、耗时（long）
    initial recipe("ws1", ["apples", "pastry"], "apple-pie", 2000l);
    initial recipe("ws2", ["apple-pie", "box"], "boxed-pie", 2000l);

    // 启动：建场景、创建 Robot agent、发现 zone、处理订单
    plan +!main(list args) {
        cartago.startService();
        cartago.link();

        !setup();

        !floorplan(cartago.ArtifactId _);

        foreach (robotSpec(string name)) {
            S.createAgent(name, "Robot");
            +idle(name);
        }

        !discoverZones();

        !metrics(cartago.ArtifactId _);

        foreach (zoneOf("PackagingPoint", string pp)) {
            !orderLoop(pp);
        }
    }

    // 分派搬运给任一空闲机器人（集中式分配）；全忙则稍后重试
    plan +!transfer(string from, string to) : idle(string r) {
        -idle(r);
        cartago.println("[RB] " + from + " -> " + to + " assigned to " + r);
        !transfer(r, from, to);
    }

    plan +!transfer(string from, string to) {
        S.sleep(500);
        !transfer(from, to);
    }

    // 机器人充满电，重新空闲
    plan @message(inform, string sender, ready(string r)) {
        +idle(r);
    }

    // 请求机器人搬运并等待回执；收到 failure 则本目标失败，不永久等待
    plan +!transfer(string name, string from, string to) {
        send(request, name, transfer(from, to));
        wait(transferred(from, to) | failed(from, to));
        if (failed(from, to)) {
            -failed(from, to);
            cartago.println("[OM] transfer " + from + " -> " + to + " failed");
            S.fail();
        }
        -transferred(from, to);
    }

    // 收到搬运失败回执
    plan @message(failure, string sender, transfer(string from, string to)) {
        +failed(from, to);
    }

    // 收到搬运回执
    plan @message(inform, string sender, transferred(string from, string to)) {
        cartago.println(sender + " is at location: " + to);
        +transferred(from, to);
    }

    // 按场景信念创建所有工件
    plan +!setup() {
        !warehouse(cartago.ArtifactId wId);
        foreach (stock(string item, int qty)) {
            !addToWarehouse(item, qty);
        }

        !floorplan(cartago.ArtifactId fpId);

        foreach (zone(string type, string name)) {
            !createZone(type, name);
        }

        foreach (robotSpec(string name)) {
            !robot(name, cartago.ArtifactId rid);
        }

        foreach (recipe(string ws, list inputs, string output, long duration)) {
            !configure(ws, inputs, output, duration);
        }
    }

    // 处理下一张订单：装单 → 生产 → 校验 → 交付 → 记账
    plan +!orderLoop(string pp) : orderSpec(string id, list items, int value) & metrics(cartago.ArtifactId mId) {
        -orderSpec(id, items, value);                  // 出队
        !order(pp, items);                             // LoadOrder：status → loaded
        cartago.operation(mId, orderStarted(id));      // P6
        try {
            forall (string item : items) {
                !produceItem(pp, item);
            }
            ?orderStatus(pp, "fulfilled");             // 安全检查：零件全到才能 deliver
            !deliver(pp);                              // DeliverOrder：status → cleared
            cartago.operation(mId, orderFulfilled(id, value));
        } recover {
            cartago.println("[OM] order " + id + " failed, stop at " + pp);  // 包装点仍是 loaded，不能接下一单
            foreach (orderSpec(string oid, list oit, int ov)) {
                -orderSpec(oid, oit, ov);              // 清空队列，避免下一单撞 setOrder
            }
        }
        !orderLoop(pp);                                // 下一张
    }

    // 订单处理完毕
    plan +!orderLoop(string pp) {
        cartago.println("[OM] all orders done at " + pp);
    }

    // 按类型创建 zone
    plan +!createZone("ap", string name) { !accessPoint(name, cartago.ArtifactId aid); }
    plan +!createZone("sp", string name) { !storagePoint(name, cartago.ArtifactId aid); }
    plan +!createZone("pp", string name) { !packagingPoint(name, cartago.ArtifactId aid); }
    plan +!createZone("ws", string name) { !workstation(name, cartago.ArtifactId aid); }

}
