// ============================================================================
// Base.astra —— 公共能力层（抽象基类 agent）
//
// 定位：它本身【不会被实例化】，只作为 Main 与 Robot 的父 agent（extends Base）。
//       作用是把"如何创建/操作各种工厂工件"的计划库集中写一处，避免重复。
//
// 整体设计模式（贯穿全文）：
//   1) 每个 !xxx 计划 = "获取工件句柄"（幂等：先 lookup，失败才 make）
//   2) 拿到句柄后把「名字 → ArtifactId」以信念形式存下（这就是 types main 里的公式）
//   3) 后续所有操作都靠 ?xxx 查询计划读取工件的观察属性（observable property）
//
// 三类"计划前缀"的读法：
//   +!name  外部调用（子目标）      +?name  查询（无副作用，返回绑定值）
//   @message(...)  消息处理器
// ============================================================================
agent Base {
    // ------------------------------------------------------------------------
    // types main —— 信念（belief）公式声明
    // 用来记录"逻辑名字 → CArtAgO 工件句柄"的映射，供后续计划做前置条件判断。
    // 例如 accessPoint("ap1", <id>) 表示"叫 ap1 的取料点是这个工件"。
    // ------------------------------------------------------------------------
    types main {
        formula floorplan(cartago.ArtifactId);      // 场地总表（全场景唯一）

        formula warehouse(cartago.ArtifactId);      // 仓库
        formula accessPoint(string, cartago.ArtifactId);  // 取料点：名字 + 句柄

        formula storagePoint(string, cartago.ArtifactId); // 存储点

        formula chargePoint(string, cartago.ArtifactId);  // 充电点
        formula robot(string, cartago.ArtifactId);        // 机器人"工件"（非 agent）
        formula at(string, string);                       // 谁 在 哪里

        formula workstation(string, cartago.ArtifactId);  // 工作站

        formula packagingPoint(string, cartago.ArtifactId); // 包装点
    }

    // ------------------------------------------------------------------------
    // 推理规则（inference）：不靠收消息，而是从已有信念"推出"新信念。
    // 只要 (a) 我知道有个叫 name 的机器人工件，(b) 我正关注着它，
    // 且 (c) 该工件的 at 属性值 = location，
    // 就自动得出信念 at(name, location)。
    // 这就是 Robot agent 里必须 cartago.focus(rid) 的原因：不聚焦就看不到它的属性。
    // ------------------------------------------------------------------------
    inference at(string name, string location) :- 
            robot(name, cartago.ArtifactId rid) & cartago.at(location);

    // ------------------------------------------------------------------------
    // types comms —— 通信词汇表（仅在 agent 之间传递的消息内容里用）
    //   transfer(from, to)     请求：把货物从 from 搬到 to
    //   transferred(from, to)  回复：搬运已完成
    // ------------------------------------------------------------------------
    types comms {
        formula transfer(string, string);
        formula transferred(string, string);
    }

    // ------------------------------------------------------------------------
    // 模块加载（相当于 import）
    //   cartago : CArtAgO 平台 API（startService / makeArtifact / operation / ...）
    //   S       : System 模块（createAgent / sleep / fail / name）
    //   pe      : 自定义模块 PropertyExtractor，把观察属性转成 ASTRA 值
    //   P       : Prelude 模块（列表操作，如 headAsString）
    // ------------------------------------------------------------------------
    module Cartago cartago;
    module System S;
    module modules.PropertyExtractor pe;
    module Prelude P;

    //******************************************************************************************
    // FLOORPLAN —— 场地总表
    // 所有 zone（取料点/存储点/包装点/工作站/充电点）都会 install 到它身上，
    // 因此 Floorplan 是"谁占了哪个 zone"的唯一权威。
    //******************************************************************************************

    // 获取 Floorplan 句柄。幂等写法：先尝试按名字查找（比如别的 agent 已建好），
    // 查不到才真正创建，最后统一把句柄记进信念 floorplan(aid)。
    plan +!floorplan(cartago.ArtifactId aid) {
        try {
            cartago.lookupArtifact("floorplan", aid);
        } recover {
            cartago.makeArtifact("floorplan", "artifacts.Floorplan", cartago.params([]), aid);
        }
        +floorplan(aid);
    }

    // 查询：当前场地上所有 zone 的名字列表。
    // 读的是 Floorplan 的观察属性 locations（一个集合），
    // 用 pe.listValues 转成 ASTRA 列表后绑定给 locations 变量。
    // ★ 这是"动态获知场地有哪些区域"的入口，是摆脱硬编码的关键。
    plan +?locations(list locations) :
            floorplan(cartago.ArtifactId fpId) {
        cartago.operation(fpId, observeProperty("locations", cartago.ArtifactObsProperty prop));
        locations = pe.listValues(prop);
    }

    // 查询：检查某个 zone 是否空闲（没有机器人占用）。
    // 调用 Floorplan 的 isOccupied 操作拿回布尔值，被占则本计划失败(S.fail)，
    // 于是调用方（+!at）会整体失败而不会真的撞车。
    plan +?free(string location) :
            floorplan(cartago.ArtifactId fpId) {
        cartago.operation(fpId, isOccupied(location, boolean occupied));
        if (occupied) S.fail();
    }

    //******************************************************************************************
    // WAREHOUSE —— 仓库（库存源）
    // 注意：Warehouse 不 install 进 Floorplan，所以它不是一个 zone，
    //       机器人无法进入仓库；取货只能通过 Access Point 间接完成。
    //******************************************************************************************

    // 获取仓库句柄（同样是 lookup-or-create 的幂等写法）。
    plan +!warehouse(cartago.ArtifactId aid) {
        try {
            cartago.lookupArtifact("warehouse", aid);
        } recover {
            cartago.makeArtifact("warehouse", "artifacts.Warehouse", cartago.params([]), aid);
        }
        +warehouse(aid);
    }

    // 向仓库进货：给某种物料增加 quantity 件。
    // 前置条件（guard）是已持有仓库句柄。仓库内部按物料类型各维护一个计数属性。
    plan +!addToWarehouse(string item, int quantity) : warehouse(cartago.ArtifactId aid) {
        cartago.operation(aid, add(item, quantity));
    }

    //******************************************************************************************
    // ACCESS POINT —— 取料点：把原料从仓库"取出"到场地上的中转位
    //******************************************************************************************

    // 创建取料点（前置：仓库与 Floorplan 都已存在）。
    // 需要建立两条链接：
    //   out-fp → Floorplan：让本区域登记进场地并参与占用管理
    //   out-1  → Warehouse：取料时通过这条链接向仓库要货
    plan +!accessPoint(string name, cartago.ArtifactId aid) : 
            warehouse(cartago.ArtifactId warehouseId) &
            floorplan(cartago.ArtifactId fpId) {
        try {
            cartago.lookupArtifact(name, aid);
        } recover {
            cartago.makeArtifact(name, "artifacts.AccessPoint", cartago.params([]), aid);

            // Install AP In Floorplan
            cartago.linkArtifacts(aid, "out-fp", fpId);
            cartago.operation(aid, install());

            // Connect AP to Warehouse
            cartago.linkArtifacts(aid, "out-1", warehouseId);
        }
        +accessPoint(name, aid);
    }

    // 取料：让取料点从仓库取出 type 类型的物料（一次一件，取出后不可退回）。
    // 取出后立刻用 ?available 复核，确保操作真的生效。
    plan +!available(string name, string type) :
            accessPoint(name, cartago.ArtifactId aid) {
        cartago.operation(aid, retrieve(type));
        ?available(name, type);
    }

    // 查询取料点当前放的是什么（读观察属性 available）。
    // 两种用法：
    //   ?available("ap1", string T)    T 未绑定 → 把实际值绑给 T 并打印（读）
    //   ?available("ap1", "apples")    T 已绑定 → 与实际值比较，不符则失败（校验）
    plan +?available(string name, string type) :
            accessPoint(name, cartago.ArtifactId aid) {
        cartago.operation(aid, observeProperty("available", cartago.ArtifactObsProperty prop));
        if (~pe.isBound(type)) {
            type = pe.stringValue(prop);
            cartago.println(type + " is available at access point: " + name);
        } else if (type ~= pe.stringValue(prop))
            S.fail();
    }

    //******************************************************************************************
    // STORAGE POINT —— 存储点：容量 1 件的临时缓冲
    // 只实现"创建 + 查询"；把货放进去 / 取出来分别是工件的 give / take 操作，
    // 由 Robot 工件的 load()/unload() 间接触发（StoragePoint 在合法装卸白名单里）。
    //******************************************************************************************

    // 创建存储点，并把它 install 到 Floorplan（使其成为一个 zone）。
    plan +!storagePoint(string name, cartago.ArtifactId aid) : 
            floorplan(cartago.ArtifactId fpId) {
        try {
            cartago.lookupArtifact(name, aid);
        } recover {
            cartago.makeArtifact(name, "artifacts.StoragePoint", cartago.params([]), aid);

            // Install AP In Floorplan
            cartago.linkArtifacts(aid, "out-fp", fpId);
            cartago.operation(aid, install());
        }
        +storagePoint(name, aid);
    }

    // 查询存储点里现在放着什么（与取料点的同名计划语义一致：未绑定=读，已绑定=校验）。
    plan +?available(string name, string type) :
            storagePoint(name, cartago.ArtifactId aid) {
        cartago.operation(aid, observeProperty("available", cartago.ArtifactObsProperty prop));
        if (~pe.isBound(type)) {
            type = pe.stringValue(prop);
            cartago.println(type + " is available at storage point: " + name);
        } else if (type ~= pe.stringValue(prop))
            S.fail();
    }

    //******************************************************************************************
    // PACKAGING POINT —— 包装点：收集订单所需零件并交付发货
    //******************************************************************************************

    // 创建包装点并 install 到 Floorplan（使它成为一个 zone）。
    plan +!packagingPoint(string name, cartago.ArtifactId aid) : 
            floorplan(cartago.ArtifactId fpId) {
        try {
            cartago.lookupArtifact(name, aid);
        } recover {
            cartago.makeArtifact(name, "artifacts.PackagingPoint", cartago.params([]), aid);

            // Install PP In Floorplan
            cartago.linkArtifacts(aid, "out-fp", fpId);
            cartago.operation(aid, install());
        }

        +packagingPoint(name, aid);
    }

    // 给包装点装入一张订单（order 是所需零件的类型列表）。
    // ⚠️ 工件内部用 defineObsProperty 定义 order/outstanding，
    //    同名属性重复定义会报错 → 本计划对一个包装点【只能调用一次】。
    plan +!order(string name, list order) :
            packagingPoint(name, cartago.ArtifactId aid) {
        cartago.operation(aid, setOrder(order));
    }

    //******************************************************************************************
    // ROBOT —— 机器人"工件"（能力层）
    // 注意：这里创建的是 CArtAgO 工件，不是 agent。
    //       真正会执行搬运动作的是 Robot.astra 里的 agent（由 S.createAgent 创建）。
    //******************************************************************************************

    // 创建机器人：先建配套充电点，再由充电点创建机器人本体。
    // 顺序很关键 —— RobotChargePoint.install(name) 内部会
    //   makeArtifact(name, "artifacts.Robot", [充电点名, maxEnergy])
    // 因此机器人的初始位置(home)就是它的充电点。
    // maxEnergy 硬编码为 800（cartago.params([800])）。
    plan +!robot(string name, cartago.ArtifactId rid) :
            floorplan(cartago.ArtifactId fpId) {
        try {
            // 已存在（例如第二个 agent 也来获取句柄）：只补记信念
            cartago.lookupArtifact(name, rid);
            cartago.lookupArtifact(name+"-charger", cartago.ArtifactId rcId);
            +chargePoint(name+"-charger", rcId);
        } recover {
            cartago.makeArtifact(name+"-charger", "artifacts.RobotChargePoint", cartago.params([800]), cartago.ArtifactId rcId);
            +chargePoint(name+"-charger", rcId);

            // Install AP In Floorplan
            cartago.linkArtifacts(rcId, "out-fp", fpId);
            // 该操作内部会创建名为 name 的 Robot 工件，并把充电点登记为它的位置
            cartago.operation(rcId, install(name));

            cartago.lookupArtifact(name, rid);
            cartago.linkArtifacts(rid, "out-fp", fpId);

            cartago.println(name + " CREATED");
        }
        +robot(name, rid);
    }

    // 查询机器人在哪个 zone（读 Robot 工件的 at 观察属性）。
    // 语义同前面：未绑定=读并打印，已绑定=比较校验。
    plan +?at(string name, string location) :
            robot(name, cartago.ArtifactId rid) {
        cartago.operation(rid, observeProperty("at", cartago.ArtifactObsProperty prop));
        if (~pe.isBound(location)) {
            location = pe.stringValue(prop);
            cartago.println(name + " is at location: " + location);
        } else if (location ~= pe.stringValue(prop))
            S.fail();
    }

    // 移动指令的"空操作"分支：如果机器人已经在目标位置，就什么都不做（省时省电）。
    // 这条计划因 guard 更具体而优先于下面那条。
    plan +!at(string name, string location) : at(name, location) { }

    // 移动指令的"真正移动"分支：先确认目标 zone 空闲（?free，被占则失败），
    // 再调用 Robot 工件的 move 操作（内部耗时 2 秒并扣能量）。
    plan +!at(string name, string location) :
            robot(name, cartago.ArtifactId rid) {
        ?free(location);
        cartago.operation(rid, move(location));
    }

    // 装载：让机器人从"当前所在工件"拿起一件货。
    // 具体从哪个工件拿，由 Robot 工件内部根据 at 位置自行解析（取料点/存储点/工作站）。
    // load 完成后读取 holding 属性，把货物类型打印出来。
    plan +!holding(string name, string item) : 
            robot(name, cartago.ArtifactId rid) {
        cartago.operation(rid, load());
        ?holding(name, item);
        cartago.println(name + " is holding " + item);
    }

    // 查询机器人手上拿着什么（读 holding 属性；空手时为字符串 "none"）。
    plan +?holding(string name, string item) :
            robot(name, cartago.ArtifactId rid) {
        cartago.operation(rid, observeProperty("holding", cartago.ArtifactObsProperty prop));
        item = pe.stringValue(prop);
    }

    // 卸载：把货物交给"当前所在工件"（包装点/存储点/工作站）。
    // 先读出货物类型以便打印日志，再执行 unload（同样耗时并扣能量）。
    plan +!empty(string name) : 
            robot(name, cartago.ArtifactId rid) {
        
        ?holding(name, string item);

        cartago.operation(rid, unload());
        cartago.println(name + " is no longer holding " + item);
    }

    //******************************************************************************************
    // WORKSTATION —— 工作站：按配方把多个输入零件加工成一个输出零件
    // 生命周期：idle → ready（输入凑齐）→ active（生产）→ done（产出）→ idle（被取走）
    //******************************************************************************************

    // 创建工作站并 install 到 Floorplan。
    // 注意这里【没有】try/recover：工作站不做幂等保护，重复建会抛异常。
    plan +!workstation(string name, cartago.ArtifactId aid) :
            floorplan(cartago.ArtifactId fpId) {
        cartago.makeArtifact(name, "artifacts.Workstation", cartago.params([]), aid);

        // Install AP In Floorplan
        cartago.linkArtifacts(aid, "out-fp", fpId);
        cartago.operation(aid, install());    
        +workstation(name, aid);
    }

    // 配置配方：inputs=所需输入零件类型列表，output=产出类型，duration=生产耗时(毫秒)。
    // ⚠️ duration 声明为 long，调用时必须写 2000l 这样的字面量。
    // ⚠️ 工件内部用 defineObsProperty 定义 inputs/output/duration，同名重复配置会报错。
    plan +!configure(string name, list inputs, string output, long duration) :
            workstation(name, cartago.ArtifactId wid) {
        
        // DO ACTUAL CONFIGURATION HERE...
        cartago.operation(wid, configure(inputs, output, duration));
        cartago.println(name + " is configured (inputs: " + inputs + "; output: " + output + ")" );
    }

    // 查询工作站还缺哪些输入零件（读 inputsNeeded 属性，一个字符串列表）。
    // 每收到一件匹配的输入，工件内部会把它从该列表移除；空了就意味着 ready。
    // ★ 这是"按需取料"的依据，替代手工写死下一步取什么。
    plan +?inputsNeeded(string name, list inputs) :
            workstation(name, cartago.ArtifactId wid) {
        cartago.operation(wid, observeProperty("inputsNeeded", cartago.ArtifactObsProperty prop));
        inputs = pe.listValues(prop);
    }

    // 查询工作站状态（读 state 属性：idle / ready / active / done）。
    // 语义同前：未绑定=读，已绑定=比较校验（失败则 S.fail）。
    plan +?state(string name, string state) :
            workstation(name, cartago.ArtifactId wid) {
        cartago.operation(wid, observeProperty("state", cartago.ArtifactObsProperty prop));
        if (~pe.isBound(state))
            state = pe.stringValue(prop);
        else if (state ~= pe.stringValue(prop))
            S.fail();
    }

    // 启动生产。整段是"同步等待"写法：
    //   1) 先确认处在 ready 状态（否则直接失败，不冒险开工）
    //   2) 调用 operate()，工件内部 active → sleep(duration) → done
    //   3) 由于 operate() 返回时工件其实还在生产，必须轮询 ?state 直到读到 "done"
    plan +!operate(string name) :
            workstation(name, cartago.ArtifactId ws1Id) {
        // Check workstation is in correct state...
        ?state(name, "ready");

        // Operate
        cartago.operation(ws1Id, operate());

        // Wait for operation to complete
        //?state("ws1", string state);
        ?state(name, string state);
        while (state ~= "done") {
            S.sleep(500);
            //?state("ws1", string state2);
            ?state(name, string state2);
            state = state2;
        }

        //cartago.println("ws1 is: " + state);
        cartago.println(name + " is: " + state);
    }
}